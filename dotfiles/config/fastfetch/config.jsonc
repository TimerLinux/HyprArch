{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "logo": { "type": "none" },

    "display": {
        "separator": "",
        "color": { "keys": "green", "title": "green", "output": "38;2;255;255;255" }
    },

    "modules": [
        { "type": "custom", "format": "\u001b[32m╭─ \u001b[1mSYSTEM\u001b[0m\u001b[32m ─────╮\u001b[0m" },
        { "type": "os", "key": "\u001b[32m│  \uf303  \u001b[38;2;255;255;255mOS       \u001b[32m│  " },
        { "type": "kernel", "key": "\u001b[32m│  \uf17c  \u001b[38;2;255;255;255mKERNEL   \u001b[32m│  " },
        { "type": "packages", "key": "\u001b[32m│  \uf487  \u001b[38;2;255;255;255mPACKAGES \u001b[32m│  " },
        { "type": "wm", "key": "\u001b[32m│  \uf2d0  \u001b[38;2;255;255;255mWM       \u001b[32m│  " },
        { "type": "shell", "key": "\u001b[32m│  \uf120  \u001b[38;2;255;255;255mSHELL    \u001b[32m│  " },
        { "type": "terminal", "key": "\u001b[32m│  \ue795  \u001b[38;2;255;255;255mTERMINAL \u001b[32m│  " },
        { "type": "custom", "format": "\u001b[32m├─ \u001b[1mHARDWARE\u001b[0m\u001b[32m ───┤\u001b[0m" },
        { "type": "cpu", "key": "\u001b[32m│  \uf2db  \u001b[38;2;255;255;255mCPU      \u001b[32m│  ", "format": "{1}" },
        { "type": "gpu", "key": "\u001b[32m│  \uf108  \u001b[38;2;255;255;255mGPU      \u001b[32m│  ", "format": "{2}" },
        { "type": "memory", "key": "\u001b[32m│  \udb80\udf5b  \u001b[38;2;255;255;255mRAM      \u001b[32m│  " },
        { "type": "disk", "key": "\u001b[32m│  \uf0a0  \u001b[38;2;255;255;255mDISK     \u001b[32m│  ", "folders": "/" },
        { "type": "custom", "format": "\u001b[32m├─ \u001b[1mTIME\u001b[0m\u001b[32m ───────┤\u001b[0m" },
        { "type": "uptime", "key": "\u001b[32m│  \uf017  \u001b[38;2;255;255;255mUPTIME   \u001b[32m│  " },
        { "type": "command", "key": "\u001b[32m│  \uf1fd  \u001b[38;2;255;255;255mAGE      \u001b[32m│  ", "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days" },
        { "type": "custom", "format": "\u001b[32m╰──────────────╯\u001b[0m" },
        "break",
        { "type": "custom", "format": "  \u001b[31m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m●\u001b[0m" },
        // Odstęp od dołu (przed znakiem zachęty terminala)
        "break",
    ]
}
